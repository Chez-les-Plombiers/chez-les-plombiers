# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
.env*.local
.gstack/

# ⚠️ Les pages de l'ancien site, mises de côté à la bascule du 22/09/2026.
# Elles ne sont PAS versionnées : leur historique complet est dans Git, aux
# commits antérieurs. Le dossier n'existe que le temps qu'Étienne confirme
# qu'on n'y revient pas — après quoi il se supprime sans rien perdre.
.archive-ancien-site/
